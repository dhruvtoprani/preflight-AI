# OpenAI
OPENAI_API_KEY=
PREFLIGHT_LLM_MODEL=gpt-4.1-mini
PREFLIGHT_OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
PREFLIGHT_LLM_TIMEOUT_SECONDS=45
PREFLIGHT_LLM_RETRIES=1

# Runner mode: auto | llm | deterministic
PREFLIGHT_RUNNER_MODE=auto
PREFLIGHT_MAX_PARALLEL_AGENTS=4
PREFLIGHT_REVIEW_TIMEOUT_SECONDS=50

# Moderator mode: auto | llm | deterministic
PREFLIGHT_MODERATOR_MODE=auto
PREFLIGHT_MODERATOR_MAX_BLOCKERS=5
PREFLIGHT_MODERATOR_MAX_DEPENDENCIES=5
PREFLIGHT_MODERATOR_MAX_QUESTIONS=8
PREFLIGHT_MODERATOR_MAX_OWNERS=6
PREFLIGHT_MODERATOR_MAX_AGENDA_ITEMS=6

# Optional: override team policy json and prompt template dir
PREFLIGHT_TEAM_POLICY_PATH=
PREFLIGHT_PROMPT_TEMPLATE_DIR=
PREFLIGHT_INDEX_PATH=

# Orchestrator routing
ORCHESTRATOR_BASE_URL=http://localhost:8000

# History API auth (recommended for non-local environments)
PREFLIGHT_HISTORY_API_TOKEN=

# Jira connector
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL_FILTER=
JIRA_PAGE_SIZE=50
JIRA_TIMEOUT_SECONDS=30

# Confluence connector
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_PAGE_SIZE=50
CONFLUENCE_TIMEOUT_SECONDS=30

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# Data
# Postgres-backed run persistence activates when DATABASE_URL points to postgres and psycopg is installed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/preflight
# File fallback target when Postgres is unavailable.
PREFLIGHT_RUN_DIR=
# File fallback retention policy.
PREFLIGHT_RUN_FILE_RETENTION_DAYS=30
PREFLIGHT_RUN_FILE_MAX_FILES=1000
# Optional DB timeout + diagnostics checks.
PREFLIGHT_DB_CONNECT_TIMEOUT_SECONDS=3
PREFLIGHT_PERSISTENCE_HEALTH_DB_CHECK=false
PREFLIGHT_PERSISTENCE_STARTUP_DB_CHECK=false
PREFLIGHT_PERSISTENCE_STRICT=false
REDIS_URL=redis://localhost:6379/0

# Runtime
LOG_LEVEL=INFO
ENV=local
